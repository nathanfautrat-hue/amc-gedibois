    <script>
        (function() {
            try {
                var cookieName = 'CookieConsent';
                var domain = window.location.hostname;
                var pathParts = window.location.pathname.split('/');
                var firstSegment = pathParts[1];
                if (!firstSegment) {
                    return;
                }
                var pathsToDelete = ['/' + firstSegment, '/' + firstSegment + '/'];

                // Check if CookieConsent exists
                var allCookies = document.cookie.split(';');
                var found = false;
                for (var i = 0; i < allCookies.length; i++) {
                    var c = allCookies[i].trim();
                    if (c.indexOf(cookieName + '=') === 0) {
                        found = true;
                        break;
                    }
                }

                if (!found) {
                    console.log('No CookieConsent found.');
                    return;
                }

                // Delete both variants
                for (var j = 0; j < pathsToDelete.length; j++) {
                    var p = pathsToDelete[j];
                    if (p === '/') continue;

                    document.cookie = cookieName + '=; path=' + p + '; domain=' + domain + '; expires=Thu, 01 Jan 1970 00:00:01 GMT;';
                    document.cookie = cookieName + '=; path=' + p + '; expires=Thu, 01 Jan 1970 00:00:01 GMT;';
                }

                console.log('Deleted CookieConsent for paths:', pathsToDelete.join(', '));
            } catch (e) {
                console.log('Error deleting CookieConsent:', e.message);
            }
        })();
    </script>


